<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.7 (Waylith engine) build.
    Targets net10.0 and references Assembly-CSharp, UnityStubs and Waylith from the game folder
    plus Harmony 3 from the Harmony workshop mod. No Unity DLLs are referenced any more.

    If your folders are laid out differently, override these on the command line, e.g.
      dotnet build -c Release -p:RimWorldDir="D:\Games\RimWorld\" -p:HarmonyDir="D:\...\2009463077\1.7\Assemblies\"
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>GeneSpawner_02</RootNamespace>
    <AssemblyName>GeneSpawner_02</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>[1001]Gene Spawn</Product>
    <Company>papercrane1001</Company>
    <Copyright>Copyright © 2026 papercrane1001 (MIT)</Copyright>

    <!-- Put the DLL straight into 1.7\Assemblies with no net10.0 subfolder, and skip the .deps.json RimWorld ignores. -->
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 1.7\Source\GeneSpawner_02 -> up 5 = ...\steamapps\common\RimWorld\ -->
    <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(MSBuildProjectDirectory)\..\..\..\..\..\</RimWorldDir>
    <HarmonyDir Condition=" '$(HarmonyDir)' == '' ">$(RimWorldDir)..\..\workshop\content\294100\2009463077\1.7\Assemblies\</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
